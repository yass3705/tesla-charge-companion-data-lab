name: V9 bounded Electroverse checkpoint transmission
on:
  push:
    branches: [rebuild/v9-20261020]
    paths: [migration/v9/tariff-restoration-request.json]
  workflow_dispatch:
permissions:
  contents: read
  actions: read
concurrency:
  group: v9-tariff-restoration
  cancel-in-progress: false
jobs:
  checkpoint:
    if: github.ref == 'refs/heads/rebuild/v9-20261020'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    outputs:
      manifest_sha: ${{ steps.digest.outputs.sha }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.11'
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22'
      - name: Collect bounded partial status with the preserved method
        env:
          ELECTROVERSE_API_KEY: ${{ secrets.ELECTROVERSE_API_KEY }}
        run: python scripts/pilot_v9_status_checkpoint.py --out "$RUNNER_TEMP/status-pilot"
      - id: digest
        run: echo "sha=$(sha256sum "$RUNNER_TEMP/status-pilot/checkpoint-manifest.json" | cut -d' ' -f1)" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: tcc-v9-status-pilot-first
          path: |
            ${{ runner.temp }}/status-pilot/checkpoint-manifest.json
            ${{ runner.temp }}/status-pilot/manifest.json
            ${{ runner.temp }}/status-pilot/checkpoints
            ${{ runner.temp }}/status-pilot/failures
          if-no-files-found: error
          retention-days: 7
  resume:
    needs: checkpoint
    if: github.ref == 'refs/heads/rebuild/v9-20261020'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.11'
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22'
      - uses: actions/download-artifact@v4
        with:
          name: tcc-v9-status-pilot-first
          path: ${{ runner.temp }}/downloaded-status
      - name: Verify exact transferred manifest before use
        env:
          EXPECTED_SHA: ${{ needs.checkpoint.outputs.manifest_sha }}
        run: |
          test "${#EXPECTED_SHA}" -eq 64
          test "$(sha256sum "$RUNNER_TEMP/downloaded-status/checkpoint-manifest.json" | cut -d' ' -f1)" = "$EXPECTED_SHA"
      - name: Resume preserved statuses without promoting a national result
        env:
          ELECTROVERSE_API_KEY: ${{ secrets.ELECTROVERSE_API_KEY }}
        run: python scripts/pilot_v9_status_checkpoint.py --out "$RUNNER_TEMP/resumed-status" --incoming "$RUNNER_TEMP/downloaded-status"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: tcc-v9-status-pilot-resumed
          path: |
            ${{ runner.temp }}/resumed-status/checkpoint-manifest.json
            ${{ runner.temp }}/resumed-status/manifest.json
            ${{ runner.temp }}/resumed-status/checkpoints
            ${{ runner.temp }}/resumed-status/failures
          if-no-files-found: error
          retention-days: 7
