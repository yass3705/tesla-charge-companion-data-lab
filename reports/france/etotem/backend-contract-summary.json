indow._placesAutocomplete = async function (input, language, types) {\n          try {\n            var request = { input: input, language: language };\n            if (types && types !== \"null\")\n              request.includedPrimaryTypes = [types];\n            var response =\n              await google.maps.places.AutocompleteSuggestion.fetchAutocompleteSuggestions(\n                request,\n              );\n            var result = (response.suggestions || []).map(function (s) {\n              var pp = s.placePrediction;\n              return {\n                place_id: pp.placeId,\n                structured_formatting: {\n                  main_text: pp.mainText ? pp.mainText.text : \"\",\n                  secondary_text: pp.secondaryText ? pp.secondaryText.text : \"\",\n                },\n                description: pp.text ? pp.text.text : \"\",\n              };\n            });\n            return JSON.stringify(result);\n          } catch (e) {\n            console.warn(\"_placesAutocomplete error:\", e);\n            return \"[]\";\n          }\n        };\n\n        // ── Place details (geometry only) ─────────────────────────────────────\n        // Returns a JSON string with lat/lng + optional viewport corners.\n        window._placesDetails = async function (placeId) {\n          try {\n            var place = new google.maps.places.Place({ id: placeId });\n            await place.fetchFields({ fields: [\"location\", \"viewport\"] });\n            var vp = place.viewport;\n            return JSON.stringify({\n              lat: place.location.lat(),\n              lng: place.location.lng(),\n              ne_lat: vp ? vp.getNorthEast().lat() : null,\n              ne_lng: vp ? vp.getNorthEast().lng() : null,\n              sw_lat: vp ? vp.getSouthWest().lat() : null,\n              sw_lng: vp ? vp.getSouthWest().lng() : null,\n            });\n          } catch (e) {\n            console.warn(\"_placesDetails error:\", e);\n            return \"{}\";\n          }\n        };\n\n        if (window._flutterMapReadyCallback) window._flutterMapReadyCallback();\n      }\n    </script>\n    <script\n      src=\"https://maps.go"
