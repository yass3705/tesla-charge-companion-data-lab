--- /dev/null
+++ b/.github/workflows/v9-ionity-pilot.yml
@@ -0,0 +1,51 @@
+# INACTIVE REVIEW COPY. Installing or running requires explicit authorization.
+name: V9 authorized single-source pilot
+"on":
+  workflow_dispatch:
+    inputs:
+      source:
+        description: Only the reviewed IONITY family is permitted
+        required: true
+        type: choice
+        options: ['FR:ionity_direct_family']
+permissions:
+  contents: read
+  actions: read
+concurrency:
+  group: v9-authorized-ionity-pilot
+  cancel-in-progress: false
+jobs:
+  collect:
+    if: ${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/rebuild/v9-20261020' && inputs.source == 'FR:ionity_direct_family' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          persist-credentials: false
+          fetch-depth: 1
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.11'
+      - name: Collect only the reviewed public source outside checkout
+        run: python -m v9_rebuild.orchestrator --source FR:ionity_direct_family --out "$RUNNER_TEMP/tcc-v9-pilot" --workers 1 --attempts 1
+      - name: Preserve only validated output
+        if: success()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: tcc-v9-pilot-FR_ionity_direct_family-${{ github.run_id }}
+          path: |
+            ${{ runner.temp }}/tcc-v9-pilot/manifest.json
+            ${{ runner.temp }}/tcc-v9-pilot/objects
+          if-no-files-found: error
+          retention-days: 7
+      - name: Preserve failure evidence separately
+        if: failure()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: tcc-v9-pilot-failure-${{ github.run_id }}
+          path: |
+            ${{ runner.temp }}/tcc-v9-pilot/manifest.json
+            ${{ runner.temp }}/tcc-v9-pilot/failures
+          if-no-files-found: ignore
+          retention-days: 7
