e\",\n      \"freeSearchPlaceholder\": \"Numéro de carte, véhicule...\"\n    },\n    \"tagCard\": {\n      \"number\": \"Numéro\",\n      \"vehicle\": \"Véhicule\",\n      \"complementaryInformations\": \"Informations complémentaires\",\n      \"email\": \"Email\",\n      \"askForKm\": \"Demander la saisie du kilométrage\",\n      \"kmNumber\": \"Saisie du kilométrage\",\n      \"suspendAutocharge\": \"Suspendre l'autocharge\",\n      \"configuratingAutocharge\": \"Configuration de l'autocharge\",\n      \"enableCard\": \"Activer la carte\",\n      \"edit\": \"Modifier\",\n      \"editTag\": \"Modifier le badge\",\n      \"assignedBorn\": \"Borne assignée\",\n      \"fromTo\": \"Du {} au {}\",\n      \"confirmDisableCard\": \"Êtes-vous sûr de vouloir désactiver cette carte ?\",\n      \"cardDisabled\": \"La carte a été désactivée avec succès\",\n      \"tagUpdated\": \"Le badge a été mis à jour avec succès\",\n      \"inviting\": \"En attente de validation par le titulaire\",\n      \"configurated\": \"Configuré ✓\",\n      \"autochargeConfigurationState\": \"État de configuration Autocharge\",\n      \"autochargeStatus\": \"Statut Autocharge\",\n      \"autochargeNotConfigured\": \"non configuré\",\n      \"autochargeConfiguring\": \"en cours\",\n      \"autochargeConfigured\": \"configuré\",\n      \"autochargeActive\": \"actif\",\n      \"autochargeInactive\": \"inactif\",\n      \"autochargeSuspended\": \"suspendu\"\n    },\n    \"fleetAccount\": {\n      \"joinAFleet\": \"Rejoindre une flotte\",\n      \"fleetAccountCreatedAndLinked\": \"Votre compte flotte a été créé et lié avec succès.\",\n      \"definePassword\": \"Définir un mot de passe\"\n    },\n    \"tagReturn\": {\n      \"id_non_fourni\": \"ID non fourni\",\n      \"badge_non_trouve\": \"Le badge n'a pas été trouvé\",\n      \"erreur_invitation_membre_flotte\": \"Une erreur est survenue lors de l'invitation du membre de la flotte\",\n      \"erreur_mise_a_jour\": \"Une erreur est survenue lors de la 