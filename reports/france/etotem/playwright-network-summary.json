      "body": "<!doctype html>\n<html>\n  <head>\n    <!--\n      If you are serving your web app in a path other than the root, change the\n      href value below to reflect the base path you are serving from.\n\n      The path provided below has to start and end with a slash \"/\" in order for\n      it to work correctly.\n\n      For more details:\n      * https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base\n\n      This is a placeholder for base href that will be replaced by the value of\n      the `--base-href` argument provided to `flutter build`.\n    -->\n    <base href=\"/\" />\n\n    <meta charset=\"UTF-8\" />\n    <meta content=\"IE=Edge\" http-equiv=\"X-UA-Compatible\" />\n    <meta\n      name=\"description\"\n      content=\"E-TOTEM - Service de recharge pour véhicules électriques\"\n    />\n\n    <!-- iOS meta tags & icons -->\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"etotemuti\" />\n    <link rel=\"apple-touch-icon\" href=\"favicon.png\" />\n\n    <!-- Favicon -->\n    <link rel=\"icon\" type=\"image/png\" href=\"favicon.png\" />\n\n    <title>E-TOTEM - Service de recharge pour véhicules électriques</title>\n    <link rel=\"manifest\" href=\"manifest.json\" />\n\n    <script>\n      // The value below is injected by flutter build, do not touch.\n      const serviceWorkerVersion = \"149943818\";\n    </script>\n    <!-- Google Maps JS API — must load before Flutter initializes the map widget -->\n    <script>\n      function onGoogleMapsLoaded() {\n        window._googleMapsReady = true;\n\n        // ── Places autocomplete (CORS-free: uses Maps JS SDK, not REST) ──────\n        // Optional `types` filters results (e.g. \"(regions)\" for postal codes).\n        // Returns a JSON string shaped like AutocompletePrediction[] so the\n        // Dart parser does not need to change.\n        window._placesAutocomplete = async function (input, language, types) {\n          try {\n            var request = { input: input, language: language };\n            if (types && types !== \"null\")\n              request.includedPrimaryTypes = [types];\n            var response =\n              await google.maps.places.AutocompleteSuggestion.fetchAutocompleteSuggestions(\n                request,\n              );\n            var result = (response.suggestions || []).map(function (s) {\n              var pp = s.placePrediction;\n              return {\n                place_id: pp.placeId,\n                structured_formatting: {\n                  main_text: pp.mainText ? pp.mainText.text : \"\",\n                  secondary_text: pp.secondaryText ? pp.secondaryText.text : \"\",\n                },\n                description: pp.text ? pp.text.text : \"\",\n              };\n            });\n            return JSON.stringify(result);\n          } catch (e) {\n            console.warn(\"_placesAutocomplete error:\", e);\n            return \"[]\";\n          }\n        };\n\n        // ── Place details (geometry only) ─────────────────────────────────────\n        // Returns a JSON string with lat/lng + optional viewport corners.\n        window._placesDetails = async function (placeId) {\n          try {\n            var place = new google.maps.places.Place({ id: placeId });\n            await place.fetchFields({ fields: [\"location\", \"viewport\"] });\n            var vp = place.viewport;\n            return JSON.stringify({\n              lat: place.location.lat(),\n              lng: place.location.lng(),\n              ne_lat: vp ? vp.getNorthEast().lat() : null,\n              ne_lng: vp ? vp.getNorthEast().lng() : null,\n              sw_lat: vp ? vp.getSouthWest().lat() : null,\n              sw_lng: vp ? vp.getSouthWest().lng() : null,\n            });\n          } catch (e) {\n            console.warn(\"_placesDetails error:\", e);\n            return \"{}\";\n          }\n        };\n\n        if (window._flutterMapReadyCallback) window._flutterMapReadyCallback();\n      }\n    </script>\n    <script\n      src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyBiGG22d2rXWs5cptaoQPxpkjG65N1RHjU&libraries=places&callback=onGoogleMapsLoaded&loading=async\"\n      async\n      defer\n    ></script>\n\n    <!-- This script adds the flutter initialization JS code -->\n    <script src=\"flutter.js\" defer></script>\n    <style>\n      .container {\n        width: 100vw;\n        height: 100vh;\n        display: flex;\n        /* Default Axis is X*/\n        justify-content: center;\n        /* Main Axis */\n        align-items: center;\n        /* Cross Axis */\n      }\n\n      .indicator {\n        width: 4vw;\n      }\n    </style>\n  </head>\n\n  <body style=\"overflow: hidden\">\n    <div id=\"loading_indicator\" class=\"container\">\n      <img class=\"indicator\" src=\"./assets/loading.gif\" />\n    </div>\n    <script>\n      if (\"serviceWorker\" in navigator) {\n        window.addEventListener(\"load\", function () {\n          xmlhttp = new XMLHttpRequest();\n          xmlhttp.open(\"GET\", \"./version.json\", true);\n          xmlhttp.onload = function () {\n            if (xmlhttp.status == 200) {\n              var version = xmlhttp.responseText.split(\",\")[2];\n              var currentVersion = window.localStorage.getItem(\"build_number\");\n              console.log(\"current build number: \" + currentVersion);\n              console.log(\"build number: \" + version);\n              if (currentVersion == null || currentVersion != version) {\n                console.log(\"clearing cache\");\n                caches.delete(\"flutter-app-manifest\");\n                caches.delete(\"flutter-temp-cache\");\n                caches.delete(\"flutter-app-cache\");\n              }\n              window.localStorage.setItem(\"build_number\", version);\n            }\n          };\n          xmlhttp.send();\n        });\n      }\n      window.addEventListener(\"load\", function (ev) {\n        function startFlutter() {\n          _flutter.loader\n            .loadEntrypoint({\n              serviceWorker: {\n                serviceWorkerVersion: serviceWorkerVersion,\n              },\n            })\n            .then(function (engineInitializer) {\n              return engineInitializer.initializeEngine();\n            })\n            .then(function (appRunner) {\n              return appRunner.runApp();\n            });\n        }\n\n        // Defer Flutter startup until the Google Maps JS API is ready.\n        if (window._googleMapsReady) {\n          startFlutter();\n        } else {\n          window._flutterMapReadyCallback = startFlutter;\n        }\n      });\n      window.onload = function () {\n        setTimeout(function () {\n          var loadingIndicator = document.getElementById(\"loading_indicator\");\n          if (loadingIndicator) {\n            loadingIndicator.remove();\n          }\n        }, 10000);\n      };\n    </script>\n  </body>\n</html>\n"
