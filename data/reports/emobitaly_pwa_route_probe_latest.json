llapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#flush-collapseTwo\" aria-expanded=\"false\" aria-controls=\"flush-collapseOne\">\n                        iOS - Altri\n                     </button>\n                  </h6>\n                  <div id=\"flush-collapseTwo\" class=\"accordion-collapse collapse\" aria-labelledby=\"flush-headingTwo\" data-bs-parent=\"#accordionFlushExample\">\n                     <div class=\"accordion-body\">Apri la pagina con Safari per installare l'App sul tuo dispositivo</div>\n                  </div>\n               </div>\n            </div> \n\t\t  </div>\n\t  </div><!-- /.modal-content -->\n  </div><!-- /.modal-dialog -->\n</div><div class=\"modal fade\" id=\"modal-info\" data-bs-backdrop=\"static\">\n   <div class=\"modal-dialog\">\n      <div class=\"modal-content\">\n         <div class=\"modal-header\">\n            <h5 class=\"modal-title\">Info</h5>\n            <!-- <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button> -->\n         </div>\n         <div class=\"modal-body\">\n         <h5 id=\"info-body\"></h5>\n         </div>\n         <div class=\"modal-footer text-center info-footer ft1\" style=\"margin-bottom:80px\">\n            <button type=\"button\" class=\"btn btn-primary\" data-bs-dismiss=\"modal\">Chiudi</button>\n         </div>\n         <div class=\"modal-footer info-footer ft2\" style=\"margin-bottom:80px;display:none\">\n            <button type=\"button\" id=\"annulla\" class=\"btn btn-secondary\">Annulla</button>\n            <button type=\"button\" id=\"conferma\" class=\"btn btn-primary\">Conferma</button>\n         </div>\n      </div>\n      <!-- /.modal-content -->\n   </div>\n   <!-- /.modal-dialog -->\n</div>\n  <script src=\"/assets/libs/jquery/jquery.min.js\"></script>\n  <script src=\"/assets/libs/bootstrap/js/bootstrap.bundle.min.js\"></script>  \n  <script src=\"/assets/js/app-pwa.js\"></script>\n  <script>\n  \n      function infobox(info) {\n        $('#info-body').html(info);\n        $('#modal-info').modal('show');\n    }\n    \n  $(document).ready(function() {\n  \n              \n\t\t  $('.form-control').keydown(function(){\n  \t\t\t$('#smallerror').html('');\n\t\t\t});\n  \n  }); \n</script>\n\t\n    </body>\n</html>\n",
    "https://app.emobitaly.com/sw.js": "var DEBUG = true;\nvar CACHE_NAME = 'v12'; \n\nfunction log(msg){\n\tif (!DEBUG){\n\t\treturn;\n\t}\n\tvar date = new Date();\n\t//console.log(date.toLocaleTimeString() + ' ' + msg);\n}\n\nfunction error(msg){\n\tvar date = new Date();\n\t//console.error(date.toLocaleTimeString() + ' ' + msg);\n}\n\n\nself.addEventListener('install', function(event){\n\t\n\tlog('install');\n\tevent.waitUntil(\n\t\tcaches.open(CACHE_NAME).then(function(cache){\n\t\t\tcache.addAll([\n\t\t\t    '/assets/css/bootstrapX.min.css',\n\t\t\t\t'/assets/images/img-countdown.webp',\n\t\t\t\t'/assets/images/favicon.png',\n\t\t\t\t'/assets/images/logo-e2.png',\n\t\t\t\t'/assets/images/ico-sessioni.png',\n\t\t\t\t'/assets/images/ico-ios-apri.png',\n\t\t\t\t'/assets/images/ico-profilo.png',\n\t\t\t\t'/assets/images/ico-ricarica.png',\n\t\t\t\t'/assets/images/ico-ios-salva.png',\n\t\t\t\t'/assets/images/ico-booking.png',\n\t\t\t\t'/assets/css/webapp.min.css',\n\t\t\t\t'/assets/libs/jquery/jquery.min.js',\n\t\t\t\t'/assets/libs/bootstrap/js/bootstrap.bundle.min.js',\n\t\t\t\t'/assets/js/app-pwa.min.js',\n\t\t\t\t'/assets/js/app-custom.min.js',\n\t\t\t\t'/assets/js/jquery.form-validator.min.js',\n\t\t\t\t'/assets/js/lang/it.js',\n\t\t\t\t'/assets/js/valid.js',\n\t\t\t\t'https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js',\n\t\t\t\t'https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600&display=swap'\n\t\t\t]);\n\t\t})\n\t);\n});\n\n//\n// Activate\n// This fires once the old service worker is gone, and your new service worker is able to control clients.\n// This is the ideal time to do stuff that you couldn't do while the old worker was still in use, such as migrating databases and clearing caches.\n// Quando si aggiorna il service worker viene cancellata la cache precedente.\n\nself.addEventListener('activate', function(event){\n\t// Active worker won't be treated as activated until promise\n\t// resolves successfully.\n\t\n\tlog('activate');\n\tevent.waitUntil(\n\t\tcaches.keys().then(function(cacheNames){\n\t\t\treturn Promise.all(\n\t\t\t\tcacheNames.map(function(cacheName){\n\t\t\t\t\tif (cacheName != CACHE_NAME){ // cancello le vecchie cache\n\t\t\t\t\t\tconsole.log('Deleting out of date cache:', cacheName);\n\n\t\t\t\t\t\treturn caches.delete(cacheName);\n\t\t\t\t\t} else {\n\t\t\t\t\t\t//return Promise.resolve(true);\n\t\t\t\t\t\treturn true; // se ritorno un valore al posto di una Promise, viene considerato la risoluzione della Promise\n\t\t\t\t\t}\n\t\t\t\t})\n\t\t\t);\n\t\t})\n\t);\n});\n\nself.addEventListener('fetch', function(event){\n\t// Let the browser do its default thing\n\t// for non-GET requests.\n\tif (event.request.method != 'GET') return;\n\n\tvar url = event.request.url;\n\tconsole.log('fetch ' + url);\n\n\t// never use cached version for AMP CORS requests\n\tif (url.indexOf(\"__amp_source_origin\") != -1) return;\n\n\t// cache.put(): The promise will reject with a TypeError if the URL scheme is not http or https.\n\tif (url.indexOf('://') != -1 && !['http', 'https'].includes(url.substr(0, url.indexOf('://')))){\n\t\treturn;\n\t}\n\n\tlog('fetch ' + url);\n\t//\n\t// Prevent the default, and handle the request ourselves. \n\t//\n\tevent.respondWith(\n\t\tfetch(event.request).then(function(response){ // The promise does not reject on HTTP errors — it only rejects on network errors...\n\t\t\tif (!response.ok){ // ...You must use then handlers to check for HTTP errors.\n\t\t\t\terror('fetch response not ok');\n\t\t\t} else {\n\t\t\t\t//\n\t\t\t\t// cacho solo se risposta ok (200). Non cacho 404 ecc.\n\t\t\t\t//\n\t\t\t\tvar response_copy = response.clone(); // se non clono becco un \"Uncaught (in promise) TypeError: Response body is already used\"\n\t\t\t\tcaches.open(CACHE_NAME).then(function(cache){\n\t\t\t\t\tcache.put(event.request, response_copy);\n\t\t\t\t}).catch(function(){ // Può capitare?\n\t\t\t\t\terror('cache open error');\n\t\t\t\t});\n\t\t\t}\n\t\t\treturn response; // ritorno sempre la risposta: 200, 404, ecc.\n\t\t}).catch(function(){ // network error: non sono connesso a internet\n\t\t\terror('fetch error');\n\t\t\treturn caches.open(CACHE_NAME).then(function(cache){\n\t\t\t\t// The match() method of the Cache interface returns a Promise that resolves to the Response associated with the first matching request in the Cache object.\n\t\t\t\treturn cache.match(event.request).then(function(response){\n\t\t\t\t\tif (response){ // If no match is found, the Promise resolves to undefined.\n\t\t\t\t\t\tlog('serving cached content for url ' + url);\n\t\t\t\t\t\treturn response;\n\t\t\t\t\t} else {\n\t\t\t\t\t\t// www.example.com/pagina.html oppure www.example.com/ oppure www.example.com/pagina oppure www.example.com/pagina/\n\t\t\t\t\t\tif (url.indexOf('.php') != -1 || url.lastIndexOf('/') > url.lastIndexOf('.')){\n\t\t\t\t\t\t\tlog('serving offline.html for url ' + url);\n\t\t\t\t\t\t\treturn cache.match('/'); // la versione viene modificata automaticamente da index.php\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\terror('offline default not present for url ' + url);\n\t\t\t\t\t\t\t//return Promise.reject(new Error('offline default not present for url ' + url));\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}).catch(function(){ // Può capitare?\n\t\t\t\t\terror('cache match error');\n\t\t\t\t\t//return Promise.reject(new Error('cache match error'));\n\t\t\t\t});\n\t\t\t}).catch(function(){ // Può capitare?\n\t\t\t\terror('cache open error');\n\t\t\t\t//return Promise.reject(new Error('cache open error'));\n\t\t\t});\n\t\t})\n\t);\n});\n",
    "https://app.emobitaly.com/assets/js/app-pwa.js": "const registerServiceWorker = async () => {\n\tif (\"serviceWorker\" in navigator) {\n\t  try {\n\t\tconst registration = await navigator.serviceWorker.register(\"/sw.js\", {\n\t\t  scope: \"/\",\n\t\t});\n\t\tif (registration.installing) {\n\t\t  console.log(\"Service worker installing\");\n\t\t} else if (registration.waiting) {\n\t\t  console.log(\"Service worker installed\");\n\t\t} else if (registration.active) {\n\t\t  console.log(\"Service worker active\");\n\t\t}\n\t  } catch (error) {\n\t\tconsole.error('Registration failed with ${error}');\n\t  }\n\t}\n  };\n  \n  registerServiceWorker();\n\n\n//installazione pwa \n  let installPrompt = null;\n  const installButton = document.querySelector(\"#install\");\n  const installButton2 = document.querySelector(\"#install2\");\n // const customInstallBanner = document.getElementById('install-banner');\n  \n  window.addEventListener(\"beforeinstallprompt\", (event) => {\n\tevent.preventDefault();\n\tinstallPrompt = event;\n\tinstallButton.removeAttribute(\"hidden\");\n\t//customInstallBanner.style.display = 'block';\n  });\n  \n  installButton.addEventListener(\"click\", async () => {\n\tif (!installPrompt) {\n\t  return;\n\t}\n\tconst result = await installPrompt.prompt();\n\tconsole.log('Install prompt was: ${result.outcome}');\n\tdisableInAppInstallPrompt();\n  });\n  \n  function disableInAppInstallPrompt() {\n\tinstallPrompt = null;\n\t// $('.txt-Phone').hide();\n\t// $('.txt-Phone .ios-safari').hide();\n\t// $('.txt-Phone .ios-not-safari').hide();\n\tinstallButton.setAttribute(\"hidden\", \"\");\n\t//customInstallBanner.style.display = 'none';\n  }\n  \n  window.addEventListener(\"appinstalled\", () => {\n\tdisableInAppInstallPrompt();\n  });\n  \n/*  window.addEventListener(\"beforeinstallprompt\", async (event) => {\n\tconst relatedApps = await navigator.getInstalledRelatedApps();\n  \n\t// Search for a specific installed platform-specific app\n\tconst psApp = relatedApps.find((app) => app.id === \"my.emobitaly.com\");\n  \n\tif (psApp) {\n\t  event.preventDefault();\n\t  // Update UI as appropriate\n\t}\n  });*/\n\n  if (window.navigator.userAgent.indexOf(\"Chrome\") > -1) {\n\tinstallButton2.setAttribute(\"hidden\", \"\");\n\t//console.log(\"Chrome\");\n  } else {\n\tinstallButton.setAttribute(\"hidden\", \"\");\n\tinstallButton2.removeAttribute(\"hidden\");\n\t//console.log(\"Resto del mondo\");\n  }\n",
